{
 "id": "secret-detection",
 "version": 1,
 "detector": "services.source_analysis_worker.secrets",
 "labels": "Each case is one file. 'seeded' files contain exactly one synthetic secret of the expected rule; 'look-alike' files contain text that resembles a secret but must not be reported (public keys, certificates, test-mode keys, placeholders, strings one character short or embedded in a longer word). All values are synthetic and were never valid credentials. Content is stored in pieces and joined at run time.",
 "cases": [
  {
   "id": "keys-id_rsa",
   "subset": "seeded",
   "file": "keys/id_rsa",
   "expected": [
    "private_key_block"
   ],
   "content_pieces": [
    "-----BE",
    "GIN RSA",
    " PRIVAT",
    "E KEY--",
    "---\nsyn",
    "thetic-",
    "one\n---",
    "--END R",
    "SA PRIV",
    "ATE KEY",
    "-----\n"
   ]
  },
  {
   "id": "keys-other-pem",
   "subset": "seeded",
   "file": "keys/other.pem",
   "expected": [
    "private_key_block"
   ],
   "content_pieces": [
    "-----BE",
    "GIN PRI",
    "VATE KE",
    "Y-----\n",
    "synthet",
    "ic-two\n"
   ]
  },
  {
   "id": "keys-ssh",
   "subset": "seeded",
   "file": "keys/ssh",
   "expected": [
    "private_key_block"
   ],
   "content_pieces": [
